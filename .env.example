# ---------- 元宝搜索（腾讯云 wsa / SearchPro）----------
# 控制台开通：https://console.cloud.tencent.com/wsapi/index
# 密钥管理：https://console.cloud.tencent.com/cam/capi
TENCENTCLOUD_SECRET_ID=
TENCENTCLOUD_SECRET_KEY=

SEARCH_MODE=2          # 0 公开网页 / 1 优质权威垂直信源 / 2 混合（推荐）
SEARCH_CNT=30

# ---------- 大模型（OpenAI 兼容协议）----------
# 方案一 腾讯云混元：https://api.hunyuan.cloud.tencent.com/v1  model=hunyuan-turbos-latest
# 方案二 DeepSeek：  https://api.deepseek.com/v1              model=deepseek-chat
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_API_KEY=
LLM_VISION=0           # 换成支持视觉的模型后改为 1（截图查证要用）

# ---------- 运行 ----------
# MOCK_SEARCH=1 时用内置样例数据，便于没拿到密钥时先跑通界面；正式演示必须为 0
MOCK_SEARCH=0
PORT=8000

# 可选：盯梢命中后推企业微信群机器人
WECOM_WEBHOOK=

# 防滥用：每设备免验证查证次数，超过后需图形验证码
CAPTCHA_THRESHOLD=10
CAPTCHA_DEBUG=0   # 调试时把验证码答案一起返回，线上必须 0

# 可信度门槛
MIN_GRADE_FOR_VERDICT=4
MIN_DISTINCT_DOMAINS=2
